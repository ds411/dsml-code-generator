{
  "name": "dsml-toolchain-dev-tools",
  "private": true,
  "description": "Node.js dev tools of the DSML toolchain. The toolchain itself is a Python project that uv manages.",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "typecheck": "pyright"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@steiger/toolkit": "0.2.3",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "pyright": "1.1.414",
    "steiger": "0.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  }
}
