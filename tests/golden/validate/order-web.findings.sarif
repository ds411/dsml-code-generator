              "name": "SYN002",
              "properties": {
                "category": "SYN"
              },
              "shortDescription": {
                "text": "OpenSysML reports a warning."
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Divide the sentence into sentences of 25 words or fewer."
              },
              "id": "TXT-001",
              "name": "TXT001",
              "properties": {
                "category": "TXT"
              },
              "shortDescription": {
                "text": "A sentence in the text of a need or requirement has more than 25 words."
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Use \"must\" for an obligation. Use \"can\" for a possibility."
              },
              "id": "TXT-002",
              "name": "TXT002",
              "properties": {
                "category": "TXT"
              },
              "shortDescription": {
                "text": "A requirement text uses \"shall\", \"should\", \"may\" or \"will\" in place of \"must\"."
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Divide the text into requirements that each have one \"must\"."
              },
              "id": "TXT-003",
              "name": "TXT003",
              "properties": {
                "category": "TXT"
              },
              "shortDescription": {
                "text": "A requirement text has more than one \"must\", so it can contain more than one requirement."
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "Allocate the application to one logical element with `allocate`."
