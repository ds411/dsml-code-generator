{#- The Steiger configuration of the Next.js target (PRD-APP-306): the
    recommended rules of the FSD plugin, with these changes:

    - The rule fsd/repetitive-naming is off, because the slice names are
      the names of the model elements (PRD-APP-206).
    - The rule fsd/insignificant-slice is off, because each model element
      has its own slice (PRD-APP-210).
    - The rule fsd/typo-in-layer-name is off, because the layers app and
      pages have the names _app and _pages (PRD-APP-303). Steiger reads
      these names as typos of the layer names.
    - The rule fsd/segments-by-purpose is off for the segment providers of
      the layer _app, because PRD-APP-210 gives this segment name. -#}
{% include "common/header.j2" %}
import fsd from "@feature-sliced/steiger-plugin";
import { defineConfig } from "steiger";

export default defineConfig([
  ...fsd.configs.recommended,
  {
    rules: {
      "fsd/insignificant-slice": "off",
      "fsd/repetitive-naming": "off",
      "fsd/typo-in-layer-name": "off",
    },
  },
  {
    files: ["./{{ layout.layer_folder("app") }}/providers/**"],
    rules: { "fsd/segments-by-purpose": "off" },
  },
]);
