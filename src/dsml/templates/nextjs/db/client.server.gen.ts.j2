{#- The Drizzle database of the Next.js target with the driver "pg"
    (PRD-APP-301, Q64). The connection values come from the environment
    variables at run time, not at build time (PRD-APP-010). The infrastructure
    generator sets the variables in the container service. migrate.gen.mjs
    reads the same variables. Data: "application". -#}
{% include "common/header.j2" %}
import "server-only";

import { drizzle, type NodePgDatabase } from "drizzle-orm/node-postgres";
import { Pool, type PoolConfig } from "pg";

import * as schema from "./schema.gen";

/** The Drizzle database of {{ application }}, with the tables of the schema. */
export type Database = NodePgDatabase<typeof schema>;

/**
 * The TLS setting of each value of DATABASE_SSL_MODE. The values have the
 * meaning of the PostgreSQL client library: "require" encrypts the
 * connection, and "verify-full" also verifies the certificate of the server.
 */
export const SSL_MODES = {
  disable: false,
  require: { rejectUnauthorized: false },
  "verify-full": true,
} as const satisfies Record<string, PoolConfig["ssl"]>;

/**
 * Read the connection values of the database from the environment
 * variables. A missing or incorrect value gives an error that names the
 * variable.
 */
export function readDatabaseConfig(
  environment: Record<string, string | undefined> = process.env,
): PoolConfig {
  const missing = [
    "DATABASE_HOST",
    "DATABASE_NAME",
    "DATABASE_USER",
    "DATABASE_PASSWORD",
  ].filter((name) => !environment[name]);
  if (missing.length > 0) {
    throw new Error(
      `The environment variables ${missing.join(", ")} must have a value.`,
    );
  }
  const port = environment.DATABASE_PORT ?? "5432";
  if (!/^[0-9]+$/.test(port)) {
    throw new Error(
      `The environment variable DATABASE_PORT has the value "${port}". It must be a number.`,
    );
  }
  const sslMode = environment.DATABASE_SSL_MODE ?? "require";
  if (!Object.hasOwn(SSL_MODES, sslMode)) {
    throw new Error(
      `The environment variable DATABASE_SSL_MODE has the value "${sslMode}". It must be ${Object.keys(SSL_MODES).join(", ")}.`,
    );
  }
  return {
    host: environment.DATABASE_HOST,
    port: Number(port),
    database: environment.DATABASE_NAME,
    user: environment.DATABASE_USER,
    password: environment.DATABASE_PASSWORD,
    ssl: SSL_MODES[sslMode as keyof typeof SSL_MODES],
  };
}

let database: Database | undefined;

/**
 * Give the Drizzle database of the application. The first call makes the
 * connection pool. The pool connects to the database only when a query
 * needs a connection.
 */
export function getDatabase(): Database {
  database ??= drizzle({ client: new Pool(readDatabaseConfig()), schema });
  return database;
}
