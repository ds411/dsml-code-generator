{#- Copy the migration command into the "standalone" output of the Next.js
    target (PRD-APP-332, PRD-APP-333). The "standalone" output has only the
    files of the server. The Dockerfile runs this script after "next build".
    The script finds the files that migrate.gen.mjs needs with the file trace
    of Next.js, and copies them into .next/standalone. The trace keeps the
    symbolic links of pnpm. The Dockerfile copies the folder "migrations".
    Data: "application". -#}
{% include "common/header.j2" %}
import { cp, lstat, mkdir, readlink, symlink } from "node:fs/promises";
import { createRequire } from "node:module";
import { dirname, join } from "node:path";

/** The file trace of Next.js. Next.js uses it for the "standalone" output. */
const { nodeFileTrace } = createRequire(import.meta.url)(
  "next/dist/compiled/@vercel/nft",
);

/** The folder of the "standalone" output. */
const STANDALONE = ".next/standalone";

/** Tell if a path exists. A symbolic link exists, also if its target does not. */
async function exists(path) {
  try {
    await lstat(path);
    return true;
  } catch {
    return false;
  }
}

/** Copy migrate.gen.mjs and the files that it needs into the "standalone" output. */
async function main() {
  const { fileList } = await nodeFileTrace(["migrate.gen.mjs"], {
    base: process.cwd(),
  });
  for (const file of [...fileList].sort()) {
    const target = join(STANDALONE, file);
    await mkdir(dirname(target), { recursive: true });
    const stats = await lstat(file);
    if (stats.isSymbolicLink()) {
      if (!(await exists(target))) {
        await symlink(await readlink(file), target);
      }
    } else if (stats.isFile()) {
      await cp(file, target);
    }
  }
  process.stdout.write(
    `Copied ${fileList.size} files of migrate.gen.mjs into ${STANDALONE}.\n`,
  );
}

await main();
