{#- The configuration of Amplify Auth on the client (PRD-APP-007,
    PRD-APP-322, Q42). The login uses Cognito managed login with the
    authorization code flow and PKCE. The option "ssr" of Amplify keeps the
    tokens in cookies, thus the Next.js adapter reads them on the server.
    Data: "callback_path", "logout_path" (the paths of the URLs of the app
    client, PRD-IAC-019), "login_path", "return_parameter", "return_key" and
    "scopes" (the OAuth scopes of the app client, sorted). -#}
{% include "common/header.j2" %}
import { Amplify } from "aws-amplify";

import type { PublicConfig } from "{{ layout.import_path("shared", "config") }}";

/** The path of the callback URL of the app client. */
export const CALLBACK_PATH = "{{ callback_path }}";

/** The path of the logout URL of the app client. */
export const LOGOUT_PATH = "{{ logout_path }}";

/** The path of the page that starts the login. */
export const LOGIN_PATH = "{{ login_path }}";

/** The query parameter of the login page that gives the path after the login. */
export const RETURN_PARAMETER = "{{ return_parameter }}";

/** The key in the session storage of the path after the login. */
export const RETURN_KEY = "{{ return_key }}";

/** The OAuth scopes of the app client. */
export const SCOPES = [{% for scope in scopes %}"{{ scope }}"{{ ", " if not loop.last }}{% endfor %}];

/**
 * Configure Amplify Auth in the browser from the public runtime values. The
 * login uses Cognito managed login with the authorization code flow and
 * PKCE. Amplify keeps the tokens in cookies.
 */
export function configureAuth(config: PublicConfig, origin: string): void {
  Amplify.configure(
    {
      Auth: {
        Cognito: {
          userPoolId: config.userPoolId,
          userPoolClientId: config.appClientId,
          loginWith: {
            oauth: {
              domain: config.loginDomain,
              scopes: [...SCOPES],
              redirectSignIn: [`${origin}${CALLBACK_PATH}`],
              redirectSignOut: [`${origin}${LOGOUT_PATH}`],
              responseType: "code",
            },
          },
        },
      },
    },
    { ssr: true },
  );
}

/**
 * Give the path to go to after the login. Only a path on this site is
 * permitted. Each other value gives the logout path.
 */
export function returnPath(value: string | null | undefined): string {
  if (
    value === null ||
    value === undefined ||
    !value.startsWith("/") ||
    value.startsWith("//") ||
    value.includes("\\")
  ) {
    return LOGOUT_PATH;
  }
  return value;
}

/** Give the URL of the login page that goes to the path after the login. */
export function loginUrl(path: string, base: string | URL): URL {
  const url = new URL(LOGIN_PATH, base);
  url.searchParams.set(RETURN_PARAMETER, path);
  return url;
}
