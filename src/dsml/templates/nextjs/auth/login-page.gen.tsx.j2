{#- The page that starts the login (PRD-APP-007, PRD-APP-323). The request
    interceptor sends a request for a protected page with no session to
    this page. The page keeps the path after the login and starts Cognito
    managed login with PKCE. Data: none. -#}
{% include "common/header.j2" %}
"use client";

import { signInWithRedirect } from "aws-amplify/auth";
import { useEffect, useState } from "react";

import { usePublicConfig } from "{{ layout.import_path("shared", "config") }}";

import {
  configureAuth,
  RETURN_KEY,
  RETURN_PARAMETER,
  returnPath,
} from "./amplify.gen";

/**
 * Start Cognito managed login. If the user has a session, go to the path
 * after the login.
 */
export async function startLogin(path: string): Promise<void> {
  window.sessionStorage.setItem(RETURN_KEY, path);
  try {
    await signInWithRedirect();
  } catch (error) {
    if (
      error instanceof Error &&
      error.name === "UserAlreadyAuthenticatedException"
    ) {
      window.location.assign(path);
      return;
    }
    throw error;
  }
}

/** The page that starts the login. */
export function LoginPage() {
  const config = usePublicConfig();
  const [failed, setFailed] = useState(false);
  useEffect(() => {
    const path = returnPath(
      new URLSearchParams(window.location.search).get(RETURN_PARAMETER),
    );
    configureAuth(config, window.location.origin);
    startLogin(path).catch(() => {
      setFailed(true);
    });
  }, [config]);
  return (
    <main>
      <p role="status">
        {failed ? "The login did not start. Try again." : "The login starts."}
      </p>
    </main>
  );
}
