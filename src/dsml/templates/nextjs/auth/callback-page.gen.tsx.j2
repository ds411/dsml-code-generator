{#- The page of the callback URL of the app client (PRD-APP-007,
    PRD-APP-322). Amplify changes the authorization code into tokens and
    keeps them in cookies. Then the page goes to the path after the login.
    Data: none. -#}
{% include "common/header.j2" %}
"use client";

import "aws-amplify/auth/enable-oauth-listener";

import { Hub } from "aws-amplify/utils";
import { useEffect, useState } from "react";

import { usePublicConfig } from "{{ layout.import_path("shared", "config") }}";

import { configureAuth, RETURN_KEY, returnPath } from "./amplify.gen";

/** The page of the callback URL. It completes the login. */
export function CallbackPage() {
  const config = usePublicConfig();
  const [failed, setFailed] = useState(false);
  useEffect(() => {
    const stop = Hub.listen("auth", ({ payload }) => {
      if (payload.event === "signInWithRedirect") {
        const path = returnPath(window.sessionStorage.getItem(RETURN_KEY));
        window.sessionStorage.removeItem(RETURN_KEY);
        window.location.replace(path);
      } else if (payload.event === "signInWithRedirect_failure") {
        setFailed(true);
      }
    });
    configureAuth(config, window.location.origin);
    return stop;
  }, [config]);
  return (
    <main>
      <p role="status">
        {failed ? "The login did not complete." : "The login completes."}
      </p>
    </main>
  );
}
