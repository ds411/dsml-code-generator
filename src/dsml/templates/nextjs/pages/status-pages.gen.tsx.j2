{#- The pages that are not views of the model: the home page and the "not
    found" page. The logout goes to the home page. Data: none. -#}
{% include "common/header.j2" %}
import Link from "next/link";

import { APPLICATION_TITLE } from "./app-layout.gen";

/** The home page. It needs no session. */
export function HomePage() {
  return (
    <section className="flex flex-col gap-4">
      <h1 className="text-2xl font-semibold">{APPLICATION_TITLE}</h1>
      <p className="text-muted-foreground">
        Select a view in the navigation. Log in to see the views of your roles.
      </p>
    </section>
  );
}

/** The page of an address that has no route. */
export function NotFoundPage() {
  return (
    <section className="flex flex-col gap-4">
      <h1 className="text-2xl font-semibold">Page not found</h1>
      <p className="text-muted-foreground">
        The application has no page at this address.
      </p>
      <Link
        href="/"
        className="text-primary underline-offset-4 hover:underline"
      >
        Go to the home page
      </Link>
    </section>
  );
}
