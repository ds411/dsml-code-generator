{#- The Dockerfile of the FastAPI target (PRD-APP-013, PRD-APP-133).
    A Dockerfile must not have a parser directive, because the header is
    on the first line. -#}
{% include "common/header.j2" %}

# The base images are pinned by digest (PRD-APP-013).
FROM {{ uv_image }} AS uv

FROM {{ python_image }} AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /srv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY app ./app
{% if database %}
# The one-off migration task runs "python -m app.migrate_gen" (Q53).
COPY alembic.ini ./
COPY migrations ./migrations
{% endif %}

FROM {{ python_image }} AS runtime
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin app
WORKDIR /srv
COPY --from=build /srv /srv
ENV PATH="/srv/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
USER 10001
EXPOSE 8000
CMD ["uvicorn", "app.main_gen:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
