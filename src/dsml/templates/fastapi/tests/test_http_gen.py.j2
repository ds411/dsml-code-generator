def rows(*indexes: int) -> list[tuple[str, dict[str, object]]]:
    """Give the parent rows and the rows with the indexes, for `api`."""
    return [*PARENTS, *((TABLE, ROWS[index]) for index in indexes)]


def body(row: dict[str, object]) -> dict[str, object]:
    """Give the request body of a row: the row with no key."""
    return {name: value for name, value in row.items() if name != KEY}
