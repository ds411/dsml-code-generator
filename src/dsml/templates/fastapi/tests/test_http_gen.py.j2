def test_list_limit_has_the_default_50_and_the_maximum_200() -> None:
    with api() as client:
        document = client.get("/openapi.json").json()
    operation = document["paths"][LIST_PATH][{{ operations.list.method | tojson }}]
    schemas = {item["name"]: item["schema"] for item in operation["parameters"]}
    assert schemas["limit"]["default"] == 50
    assert schemas["limit"]["maximum"] == 200
    assert schemas["offset"]["default"] == 0
