@pytest.mark.parametrize(("method", "path"), PROTECTED)
def test_operation_without_a_token_returns_401(method: str, path: str) -> None:
    with api() as client:
        response = client.request(method, path.format(key=UNKNOWN_KEY))
    assert response.status_code == 401


@pytest.mark.parametrize(("method", "path"), PROTECTED)
def test_operation_without_a_permitted_role_returns_403(method: str, path: str) -> None:
    with api() as client:
        response = client.request(method, path.format(key=UNKNOWN_KEY), headers=headers(NO_ROLE))
    assert response.status_code == 403
