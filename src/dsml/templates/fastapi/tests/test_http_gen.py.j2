def test_list_returns_the_entities_sorted_by_key_and_the_total() -> None:
    with api(rows(2, 0, 1)) as client:
{% for line in tests.request_lines("list", "LIST_PATH") %}
{{ line }}
{% endfor %}
    assert response.status_code == 200
    page = response.json()
    assert page["total"] == len(ROWS)
    assert len(page["items"]) == len(ROWS)
    for item, row in zip(page["items"], ROWS, strict=True):
        assert_same(item, row)


def test_list_gives_the_page_of_limit_and_offset() -> None:
    with api(rows(2, 0, 1)) as client:
{% for line in tests.request_lines("list", "LIST_PATH", params='{"limit": 1, "offset": 1}') %}
{{ line }}
{% endfor %}
    assert response.status_code == 200
    page = response.json()
    assert page["total"] == len(ROWS)
    assert len(page["items"]) == 1
    assert_same(page["items"][0], ROWS[1])


