"""Correct values of the `in` parameters that are not in the path."""


def handler_is_the_stub() -> bool:
    """Tell if the body of `handle` only raises `NotImplementedError`."""
    tree = ast.parse(textwrap.dedent(inspect.getsource(handle)))
    function = tree.body[0]
    assert isinstance(function, ast.AsyncFunctionDef)
    body = [
        item
        for item in function.body
        if not (isinstance(item, ast.Expr) and isinstance(item.value, ast.Constant))
    ]
    if len(body) != 1 or not isinstance(body[0], ast.Raise) or body[0].exc is None:
        return False
    error = body[0].exc
    if isinstance(error, ast.Call):
        error = error.func
    return isinstance(error, ast.Name) and error.id == "NotImplementedError"
{% if not operation.public %}


def test_operation_without_a_token_returns_401() -> None:
    with api() as client:
        response = client.request(METHOD, PATH, {{ operation.test_request_arguments }})
    assert response.status_code == 401


def test_operation_without_a_permitted_role_returns_403() -> None:
    with api() as client:
        response = client.request(METHOD, PATH, {{ operation.test_request_arguments }}, headers=headers(NO_ROLE))
    assert response.status_code == 403
{% endif %}


@pytest.mark.skipif(not handler_is_the_stub(), reason="The handler has logic.")
def test_stub_returns_501() -> None:
    with api() as client:
        response = client.request(METHOD, PATH, {{ operation.test_request_arguments }}, headers=headers(ROLE))
    assert response.status_code == 501
    assert response.headers["content-type"] == "application/problem+json"
