"""Support code of the generated HTTP tests of {{ application }}.

The HTTP tests use a PostgreSQL database. They read the connection values
from the environment variables of the database, for example
`DATABASE_HOST`. If `DATABASE_HOST` is not set, the HTTP tests do not run.
The tests delete all rows of the tables of the models. Thus use a database
for the tests only.

The first test makes the tables with `Base.metadata.create_all`. Each test
then deletes all rows. The tests sign tokens with a local key pair and give
a local JWKS. Thus they do not use the network. The generator writes this
file again at each run.
"""

import os
import time
from collections.abc import Generator, Mapping, Sequence
from contextlib import contextmanager
from datetime import datetime
from decimal import Decimal, InvalidOperation
from functools import cache
from typing import Any

import jwt
from cryptography.hazmat.primitives.asymmetric import rsa
from fastapi.testclient import TestClient
from jwt.algorithms import RSAAlgorithm
from sqlalchemy import Engine, create_engine, text

from app.main_gen import create_app
from app.shared.auth.cognito_gen import TokenVerifier, user_pool_issuer
from app.shared.config_gen import Settings, load_settings
from app.shared.db.base_gen import Base
