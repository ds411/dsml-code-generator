{{ line }}
{% endfor %}
from app.shared.db.session_gen import database_url

ENVIRON = {
{% for variable in variables if variable.mandatory and not variable.name.startswith("DATABASE_") %}
    "{{ variable.name }}": "{{ variable.test_value }}",
{% endfor %}
}
"""A value for each mandatory environment variable that is not a database value."""

DATABASE_VARIABLES = (
{% for variable in variables if variable.name.startswith("DATABASE_") %}
    "{{ variable.name }}",
{% endfor %}
)
"""The environment variables of the database that the tests read."""

{% for line in models_lines %}
{{ line }}
{% endfor %}
"""The models of the application. Their import puts their tables in `Base.metadata`."""

ISSUER = user_pool_issuer("eu-west-1", "eu-west-1_TestPool")
CLIENT_ID = "test-client"
KEY_ID = "test-key"
KEY = rsa.generate_private_key(public_exponent=65537, key_size=2048)

NO_ROLE = "dsml-test-no-role"
"""A role that no operation permits."""

SKIP_REASON = "Set DATABASE_HOST and the other database variables to run the HTTP tests."


def database_settings() -> Settings | None:
    """Give the settings with the database of the environment, or `None`."""
    environ = {name: os.environ[name] for name in DATABASE_VARIABLES if name in os.environ}
    if "DATABASE_HOST" not in environ:
        return None
    return load_settings({**ENVIRON, **environ})


SETTINGS = database_settings()
"""The settings of the HTTP tests. `None` if the environment gives no database."""


@cache
def engine() -> Engine:
    """Make the tables of the models one time, and give a synchronous engine."""
    assert SETTINGS is not None, SKIP_REASON
    result = create_engine(database_url(SETTINGS))
    Base.metadata.drop_all(result)
    Base.metadata.create_all(result)
    return result


def jwks() -> Mapping[str, Any]:
    """Give the local JWKS with the public key of `KEY`."""
    key = RSAAlgorithm.to_jwk(KEY.public_key(), as_dict=True)
    return {"keys": [{**key, "kid": KEY_ID, "alg": "RS256", "use": "sig"}]}


def headers(*roles: str) -> dict[str, str]:
    """Give the authorization header with an access token for a user with the roles."""
    now = int(time.time())
    claims = {
        "sub": "user-1",
        "username": "user-1",
        "iss": ISSUER,
        "client_id": CLIENT_ID,
        "token_use": "access",
        "cognito:groups": list(roles),
        "iat": now,
        "exp": now + 300,
    }
    token = jwt.encode(claims, KEY, "RS256", headers={"kid": KEY_ID})
    return {"Authorization": f"Bearer {token}"}


def insert(rows: Sequence[tuple[str, Mapping[str, object]]]) -> None:
    """Add rows to the tables. Each item is the table name and the values of a row."""
    with engine().begin() as connection:
        for table, row in rows:
            columns = ", ".join(f'"{name}"' for name in row)
            values = ", ".join(f":{name}" for name in row)
            statement = text(f'INSERT INTO "{table}" ({columns}) VALUES ({values})')
            connection.execute(statement, dict(row))
        # The rows give their keys. Thus the next key that the database
        # makes must be larger than the largest key of each table.
        for item in Base.metadata.sorted_tables:
            column = item.autoincrement_column
            if column is not None:
                sequence = f"pg_get_serial_sequence('\"{item.name}\"', '{column.name}')"
                largest = f'coalesce(max("{column.name}"), 0) + 1'
                connection.execute(
                    text(f'SELECT setval({sequence}, {largest}, false) FROM "{item.name}"')
                )


@contextmanager
def api(rows: Sequence[tuple[str, Mapping[str, object]]] = ()) -> Generator[TestClient]:
    """Delete all rows, add the rows, and give a client of the application."""
    with engine().begin() as connection:
        tables = ", ".join(f'"{table.name}"' for table in Base.metadata.sorted_tables)
        connection.execute(text(f"TRUNCATE {tables} RESTART IDENTITY CASCADE"))
    insert(rows)
    assert SETTINGS is not None
    app = create_app(SETTINGS)
    app.state.token_verifier = TokenVerifier(ISSUER, CLIENT_ID, jwks, min_refresh_interval=0.0)
    with TestClient(app) as client:
        yield client


def same(actual: object, expected: object) -> bool:
    """Tell if two JSON values are equal. Compare dates, times and decimal texts by value."""
    if isinstance(actual, str) and isinstance(expected, str) and actual != expected:
        try:
            return datetime.fromisoformat(actual) == datetime.fromisoformat(expected)
        except ValueError:
            pass
        try:
            return Decimal(actual) == Decimal(expected)
        except InvalidOperation:
            return False
    return actual == expected


def assert_same(actual: Mapping[str, Any], expected: Mapping[str, object]) -> None:
    """Make sure that `actual` has each value of `expected`."""
    for name, value in expected.items():
        assert name in actual, name
        assert same(actual[name], value), (name, actual[name], value)
