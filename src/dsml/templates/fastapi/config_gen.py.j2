{#- The configuration of the FastAPI target (PRD-APP-010, PRD-APP-132,
    PRD-APP-136). -#}
{% include "common/header.j2" %}
"""The configuration of the application, from environment variables.

The application reads the configuration one time at start, not at build
time. Thus one container image operates in all environments. If a
mandatory variable is missing, the application stops with a message that
names the variable.
"""

import os
from collections.abc import Mapping
{% if variables | selectattr("secret") | list %}
from dataclasses import dataclass, field
{% else %}
from dataclasses import dataclass
{% endif %}

LOG_LEVELS = ("DEBUG", "INFO", "WARNING", "ERROR")
"""The permitted values of the variable LOG_LEVEL."""


class ConfigurationError(Exception):
    """An environment variable is missing or has a value that is not correct."""


@dataclass(frozen=True, slots=True)
class Settings:
    """The configuration of the application."""
{% for variable in variables %}

    {{ variable.field }}: str{% if variable.secret %} = field(repr=False){% endif %}

    """{{ variable.doc }} Variable: `{{ variable.name }}`."""
{% endfor %}


def load_settings(environ: Mapping[str, str] | None = None) -> Settings:
    """Read the configuration from the environment variables.

    Without `environ`, the function reads the environment of the process.
    """
    values = os.environ if environ is None else environ
    settings = Settings(
{% for variable in variables %}
{% if variable.mandatory %}
        {{ variable.field }}=_mandatory(values, "{{ variable.name }}"),
{% else %}
        {{ variable.field }}=values.get("{{ variable.name }}") or "{{ variable.default }}",
{% endif %}
{% endfor %}
    )
    if settings.log_level not in LOG_LEVELS:
        raise ConfigurationError(
            f'The environment variable LOG_LEVEL has the value "{settings.log_level}". '
            f"Use one of these values: {', '.join(LOG_LEVELS)}."
        )
{% if database %}
    if not settings.database_port.isdecimal():
        raise ConfigurationError(
            f'The environment variable DATABASE_PORT has the value "{settings.database_port}". '
            "Use a port number, for example 5432."
        )
{% endif %}
{% if cors %}
    allowed_origins(settings)
{% endif %}
    return settings
{% if cors %}


def allowed_origins(settings: Settings) -> tuple[str, ...]:
    """Give the origins that can call the API from a browser (CORS).

    Each origin must start with "https://" or "http://" and must not have a
    path. An origin with "*" is not permitted.
    """
    origins = tuple(
        origin.strip() for origin in settings.cors_allowed_origins.split(",") if origin.strip()
    )
    for origin in origins:
        scheme, _, host = origin.partition("://")
        if scheme not in ("https", "http") or not host or "/" in host or "*" in host:
            raise ConfigurationError(
                f'The environment variable CORS_ALLOWED_ORIGINS has the origin "{origin}". '
                "Use origins such as https://portal.example.com, separated by commas."
            )
    if not origins:
        raise ConfigurationError(
            "The environment variable CORS_ALLOWED_ORIGINS has no origin. "
            "Use origins such as https://portal.example.com, separated by commas."
        )
    return origins
{% endif %}


def _mandatory(values: Mapping[str, str], name: str) -> str:
    value = values.get(name, "")
    if not value:
        raise ConfigurationError(
            f"The environment variable {name} is missing. Set it before the application starts."
        )
    return value
