{#- The router of one CRUD slice (PRD-APP-008, PRD-APP-102, PRD-APP-110, PRD-APP-114).
    Data: "operation" (a dsml.generate.fastapi_slices.Slice). -#}
{% include "common/header.j2" %}
"""The endpoint of the operation {{ operation.name }}: {{ operation.route }}.

{% if operation.public %}
The operation is public. It needs no token. The generator writes this
file again at each run.
{% else %}
The endpoint returns HTTP 401 if the request has no valid access token,
and HTTP 403 if the user has no role in `ALLOWED_ROLES`. The generator
writes this file again at each run.
{% endif %}
"""

{% for line in operation.endpoint_import_lines %}
{{ line }}
{% endfor %}
{% if not operation.public %}

{% for line in operation.roles_lines %}
{{ line }}
{% endfor %}
"""The roles that can use the operation (`allowedRoles`)."""
{% endif %}
{% if operation.operation == "list" %}

LIMIT_DEFAULT = {{ limit_default }}
"""The number of entities in a page if the request gives no `limit`."""

LIMIT_MAX = {{ limit_max }}
"""The maximum number of entities in a page."""
{% endif %}

router = APIRouter(tags=[{{ operation.tag }}])


{% for line in operation.decorator_lines %}
{{ line }}
{% endfor %}
{% for line in operation.signature_lines %}
{{ line }}
{% endfor %}
{% if operation.operation == "create" %}
    """Add an entity {{ operation.entity_name }}. Return HTTP 201 with the new entity."""
    return await {{ operation.call }}
{% elif operation.operation == "read" %}
    """Return the entity {{ operation.entity_name }} with the key, or HTTP 404."""
    return await {{ operation.call }}
{% elif operation.operation == "update" %}
    """Change the entity {{ operation.entity_name }} with the key, or return HTTP 404."""
    return await {{ operation.call }}
{% elif operation.operation == "delete" %}
    """Delete the entity {{ operation.entity_name }} with the key. Return HTTP 204, or HTTP 404."""
    await {{ operation.call }}
{% else %}
    """Return one page of the entities {{ operation.entity_name }}, sorted by key."""
    return await {{ operation.call }}
{% endif %}
