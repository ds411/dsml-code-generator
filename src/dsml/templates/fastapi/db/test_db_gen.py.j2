@pytest.mark.parametrize("name", sorted(MODELS))
def test_each_entity_has_a_model_with_its_table(name: str) -> None:
    assert MODELS[name].__tablename__ == name


{% if join_tables %}
@pytest.mark.parametrize("name", sorted(JOIN_TABLES))
def test_each_join_table_is_in_the_metadata(name: str) -> None:
    assert Base.metadata.tables[name] is JOIN_TABLES[name]


{% endif %}
@pytest.mark.parametrize("name", sorted(COLUMNS))
def test_columns_have_the_postgresql_types_of_the_model(name: str) -> None:
    dialect = postgresql.dialect()
    columns = {
        column.name: (
            column.type.compile(dialect=dialect),
            bool(column.nullable),
            next((key.target_fullname for key in column.foreign_keys), None),
        )
        for column in Base.metadata.tables[name].columns
    }
    assert columns == COLUMNS[name]


def test_database_url_uses_psycopg_and_the_configuration() -> None:
    url = database_url(load_settings({**ENVIRON, "DATABASE_PASSWORD": "p@ss/word"}))
    assert url.drivername == DRIVER == "postgresql+psycopg"
    assert (url.host, url.port, url.database, url.username) == ("test", 5432, "test", "test")
    assert url.password == "p@ss/word"
    assert url.query == {"sslmode": "require"}


def test_password_is_not_in_the_text_of_the_settings() -> None:
    settings = load_settings({**ENVIRON, "DATABASE_PASSWORD": "secret-value"})
    assert "secret-value" not in repr(settings)


def test_database_port_that_is_not_a_number_stops_the_app() -> None:
    with pytest.raises(ConfigurationError, match="DATABASE_PORT"):
        load_settings({**ENVIRON, "DATABASE_PORT": "five"})


def test_app_has_a_session_factory() -> None:
    app = create_app(load_settings(ENVIRON))
    assert app.state.session_factory is not None
{% if checks %}


@pytest.mark.parametrize("name", sorted(CHECKS))
def test_enumeration_columns_permit_only_their_values(name: str) -> None:
    dialect = postgresql.dialect()
    text = str(CreateTable(Base.metadata.tables[name]).compile(dialect=dialect))
    for column, values in CHECKS[name].items():
        permitted = ", ".join(f"'{value}'" for value in values)
        assert f"CHECK ({column} IN ({permitted}))" in text
{% endif %}
