{#- The outputs of the network module (PRD-IAC-011). -#}
{% include "common/header.j2" %}

output "nat_gateway_ids" {
  description = "The IDs of the NAT gateways."
  value       = aws_nat_gateway.this[*].id
}

output "private_subnet_ids" {
  description = "The IDs of the private subnets, one in each availability zone."
  value       = aws_subnet.private[*].id
}

output "public_subnet_ids" {
  description = "The IDs of the public subnets, one in each availability zone."
  value       = aws_subnet.public[*].id
}

output "vpc_id" {
  description = "The ID of the VPC."
  value       = aws_vpc.this.id
}
