{#- The resources of the local module relational-database (PRD-IAC-017,
    PRD-IAC-018, PRD-IAC-030, PRD-IAC-031). -#}
{% include "common/header.j2" %}

locals {
  tags = { "dsml:element" = var.element }
}

resource "aws_kms_key" "this" {
  description             = "The key of the storage and of the master password of ${var.name}."
  enable_key_rotation     = true
  deletion_window_in_days = 30

  tags = merge(local.tags, { Name = var.name })
}

resource "aws_kms_alias" "this" {
  name          = "alias/${var.name}"
  target_key_id = aws_kms_key.this.key_id
}

resource "aws_db_subnet_group" "this" {
  name        = var.name
  description = "The private subnets of ${var.name}."
  subnet_ids  = var.subnet_ids

  tags = merge(local.tags, { Name = var.name })
}

resource "aws_security_group" "this" {
  name        = var.name
  description = "The database ${var.name}. Only the container services that use it can connect."
  vpc_id      = var.vpc_id

  tags = merge(local.tags, { Name = var.name })
}

resource "aws_vpc_security_group_ingress_rule" "service" {
  for_each = var.source_security_group_ids

  security_group_id            = aws_security_group.this.id
  description                  = "PostgreSQL from the container service ${each.key}."
  referenced_security_group_id = each.value
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432

  tags = merge(local.tags, { Name = var.name })
}

resource "aws_vpc_security_group_egress_rule" "service" {
  for_each = var.source_security_group_ids

  security_group_id            = each.value
  description                  = "PostgreSQL from the container service ${each.key} to ${var.name}."
  referenced_security_group_id = aws_security_group.this.id
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432

  tags = merge(local.tags, { Name = var.name })
}

resource "aws_db_instance" "this" {
  identifier                    = var.name
  engine                        = "postgres"
  engine_version                = {{ engine_version | hcl_string }}
  auto_minor_version_upgrade    = true
  instance_class                = var.instance_class
  multi_az                      = var.multi_az
  allocated_storage             = 20
  max_allocated_storage         = 100
  storage_type                  = "gp3"
  storage_encrypted             = true
  kms_key_id                    = aws_kms_key.this.arn
  db_name                       = var.database_name
  username                      = var.master_username
  manage_master_user_password   = true
  master_user_secret_kms_key_id = aws_kms_key.this.key_id
  port                          = 5432
  db_subnet_group_name          = aws_db_subnet_group.this.name
  vpc_security_group_ids        = [aws_security_group.this.id]
  publicly_accessible           = false
  backup_retention_period       = 7
  copy_tags_to_snapshot         = true
  deletion_protection           = var.deletion_protection
  skip_final_snapshot           = !var.deletion_protection
  final_snapshot_identifier     = var.deletion_protection ? "${var.name}-final" : null

  tags = merge(local.tags, { Name = var.name })
}
