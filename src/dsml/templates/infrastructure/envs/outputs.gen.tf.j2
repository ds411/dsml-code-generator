{#- The outputs of an environment root module (PRD-IAC-010), and the outputs
    of the module calls. Data: "calls", a list of ModuleCall. -#}
{% include "common/header.j2" %}

output "aws_account_id" {
  description = "The AWS account ID of the environment."
  value       = local.aws_account_id
}

output "aws_region" {
  description = "The AWS Region of the environment."
  value       = local.aws_region
}

output "environment" {
  description = "The name of the environment."
  value       = local.environment
}

output "product" {
  description = "The name of the product."
  value       = local.product
}
{% for call in calls %}
{% for output in call.outputs %}

output "{{ output.name }}" {
  description = {{ output.description | hcl_string }}
  value       = {{ output.value }}
}
{% endfor %}
{% endfor %}
