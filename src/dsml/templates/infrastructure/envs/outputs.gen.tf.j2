{#- The outputs of an environment root module (PRD-IAC-010). -#}
{% include "common/header.j2" %}

output "aws_account_id" {
  description = "The AWS account ID of the environment."
  value       = local.aws_account_id
}

output "aws_region" {
  description = "The AWS Region of the environment."
  value       = local.aws_region
}

output "environment" {
  description = "The name of the environment."
  value       = local.environment
}

output "product" {
  description = "The name of the product."
  value       = local.product
}
{% for directory in user_directories %}

output "{{ directory.address }}_user_pool_id" {
  description = "The ID of the Cognito user pool of {{ directory.address }}."
  value       = module.{{ directory.address }}.user_pool_id
}

output "{{ directory.address }}_app_client_ids" {
  description = "The ID of the Cognito app client of each application of {{ directory.address }}, by HCL name."
  value       = module.{{ directory.address }}.app_client_ids
}

output "{{ directory.address }}_login_domain" {
  description = "The managed login domain of {{ directory.address }}."
  value       = module.{{ directory.address }}.login_domain
}
{% endfor %}
