{#- The outputs of an environment root module (PRD-IAC-010). -#}
{% include "common/header.j2" %}

output "aws_account_id" {
  description = "The AWS account ID of the environment."
  value       = local.aws_account_id
}

output "aws_region" {
  description = "The AWS Region of the environment."
  value       = local.aws_region
}

output "environment" {
  description = "The name of the environment."
  value       = local.environment
}

output "product" {
  description = "The name of the product."
  value       = local.product
}
{% for service in container_services %}

output "{{ service.address }}_cluster_name" {
  description = "The name of the ECS cluster of the container service {{ service.element_tag }}."
  value       = module.{{ service.address }}.cluster_name
}

output "{{ service.address }}_service_name" {
  description = "The name of the ECS service of the container service {{ service.element_tag }}."
  value       = module.{{ service.address }}.service_name
}

output "{{ service.address }}_api_url" {
  description = "The API URL of the container service {{ service.element_tag }}."
  value       = module.{{ service.address }}.api_url
}

output "{{ service.address }}_migration_task_definition" {
  description = "The migration task definition of the container service {{ service.element_tag }}."
  value       = module.{{ service.address }}.migration_task_definition
}

output "{{ service.address }}_security_group_id" {
  description = "The security group of the tasks of the container service {{ service.element_tag }}."
  value       = module.{{ service.address }}.security_group_id
}

output "{{ service.address }}_private_subnet_ids" {
  description = "The subnets of the tasks of the container service {{ service.element_tag }}."
  value       = module.{{ service.address }}.private_subnet_ids
}
{% endfor %}
