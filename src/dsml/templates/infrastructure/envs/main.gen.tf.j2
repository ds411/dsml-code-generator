{#- The values of an environment root module, and the calls of the local
    modules (PRD-IAC-023). Data: "calls", a list of ModuleCall. -#}
{% include "common/header.j2" %}

locals {
  aws_account_id = {{ account_id | hcl_string }}
  aws_region     = {{ region | hcl_string }}
  environment    = {{ environment | hcl_string }}
  product        = {{ product | hcl_string }}
}
{% for call in calls %}

module "{{ call.address }}" {
  source = "../../modules/{{ call.folder }}"

{% for line in call.lines %}
  {{ line }}
{% endfor %}
}
{% endfor %}
