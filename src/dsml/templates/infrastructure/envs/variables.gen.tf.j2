{#- The variables of an environment root module (PRD-IAC-036), and the
    variables of the module calls (PRD-IAC-009). Data: "calls", a list of
    ModuleCall. -#}
{% include "common/header.j2" %}

variable "model_commit" {
  description = "The full Git commit hash of the model. The pipeline gives it at plan time. It is the value of the tag dsml:model-commit."
  type        = string
  nullable    = false

  validation {
    condition     = can(regex("^[0-9a-f]{40}([0-9a-f]{24})?$", var.model_commit))
    error_message = "The variable model_commit must be a full Git commit hash with 40 or 64 lowercase hexadecimal characters."
  }
}
{% for call in calls %}
{% for variable in call.variables %}

variable "{{ variable.name }}" {
  description = {{ variable.description | hcl_string }}
  type        = string
  nullable    = false

  validation {
    condition     = can(regex({{ variable.pattern | hcl_string }}, var.{{ variable.name }}))
    error_message = {{ variable.error_message | hcl_string }}
  }
}
{% endfor %}
{% endfor %}
