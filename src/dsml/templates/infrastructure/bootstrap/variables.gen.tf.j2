{#- The variables of a bootstrap root module (PRD-IAC-027, PRD-IAC-036). -#}
{% include "infrastructure/envs/variables.gen.tf.j2" %}

variable "github_repository" {
  description = "The GitHub repository of the model, in the form owner/name. The trust policies of the CI roles check it in the sub claim."
  type        = string
  nullable    = false

  validation {
    condition     = can(regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", var.github_repository))
    error_message = "The variable github_repository must have the form owner/name."
  }
}
