{#- The pull request workflow (PRD-CICD-001 to PRD-CICD-006, PRD-CICD-010,
    PRD-CICD-011, PRD-CICD-014, PRD-CICD-015). Each job declares its own
    permissions. Only the plan job has "id-token: write". The jobs run dsml
    through the toolchain action (PRD-CORE-050). -#}
{% macro setup(with_uv=True) %}
      - name: Check out the repository
        uses: {{ actions.checkout }}
        with:
          persist-credentials: false
{% if with_uv %}

      - name: Set up uv
        uses: {{ actions.setup_uv }}
        with:
          version: {{ uv_version | yaml_string }}
{% endif %}
{% endmacro %}
{% from "pipelines/pnpm.j2" import setup_pnpm with context %}
{% include "common/header.j2" %}

name: Pull request

on:
  pull_request:

permissions: {}

concurrency:
  group: pr-{{ "${{ github.workflow }}" }}-{{ "${{ github.ref }}" }}
  cancel-in-progress: true

jobs:
  # Validate the model and upload the findings to GitHub code scanning
  # (PRD-CICD-002). The toolchain action uploads the findings also when the
  # model has an error finding.
  validate:
    name: Validate the model
    runs-on: {{ runner }}
    timeout-minutes: 30
    permissions:
      actions: read
      contents: read
      security-events: write
    steps:
{{ setup(with_uv=False) }}
      - name: Validate the model
        uses: {{ toolchain_action }}
        with:
          version: {{ toolchain_version | yaml_string }}
          command: validate
          sarif: "true"
          sarif-category: dsml

  # Fail if a generated file is different from the committed file
  # (PRD-CICD-003).
  generate-check:
    name: Check the generated files
    runs-on: {{ runner }}
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
{{ setup(with_uv=False) }}
      - name: Check the generated files
        uses: {{ toolchain_action }}
        with:
          version: {{ toolchain_version | yaml_string }}
          command: generate
          args: --check

  # Run the language tools on the generated code (PRD-CICD-005). The job
  # installs the tools that "dsml check-output" runs, at the versions of
  # the version baseline of the toolchain.
  check-output:
    name: Check the generated code
    runs-on: {{ runner }}
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
{{ setup(with_uv=applications | length > 0) }}
{% if applications %}
      # ruff and pyright check each FastAPI application (PRD-CORE-011).
      - name: Install ruff and pyright
        env:
          PYTHON_VERSION: {{ python_line | yaml_string }}
          RUFF_VERSION: {{ tools.ruff | yaml_string }}
          PYRIGHT_VERSION: {{ tools.pyright | yaml_string }}
        run: |
          uv tool install --python "$PYTHON_VERSION" "ruff==$RUFF_VERSION"
          uv tool install --python "$PYTHON_VERSION" "pyright==$PYRIGHT_VERSION"
          uv tool dir --bin >> "$GITHUB_PATH"
{% for app in applications %}

      # pyright reads the virtual environment of {{ app.name }}.
      - name: {{ ("Install the dependencies of " ~ app.name) | yaml_string }}
        working-directory: {{ app.folder | yaml_string }}
        run: uv sync --frozen
{% endfor %}

{% endif %}
{% if check_infrastructure %}
      # OpenTofu and tflint with the AWS rule set check the infrastructure
      # code (PRD-IAC-038).
      - name: Set up OpenTofu
        uses: {{ actions.setup_opentofu }}
        with:
          tofu_version: {{ opentofu_version | yaml_string }}
          tofu_wrapper: false

      # The archives are for Linux on x64, the platform of the runner. The
      # step checks the SHA-256 hash of each archive. tflint finds the AWS
      # rule set in its plugin folder.
      - name: Install tflint and the AWS rule set
        env:
          TFLINT_VERSION: {{ tools.tflint | yaml_string }}
          TFLINT_SHA256: {{ tools.tflint_sha256 | yaml_string }}
          RULESET_VERSION: {{ tools.ruleset | yaml_string }}
          RULESET_SHA256: {{ tools.ruleset_sha256 | yaml_string }}
        run: |
          tools="$RUNNER_TEMP/tflint"
          plugins="$HOME/.tflint.d/plugins/github.com/terraform-linters/tflint-ruleset-aws/$RULESET_VERSION"
          mkdir -p "$tools" "$plugins"
          curl --fail --silent --show-error --location --output "$RUNNER_TEMP/tflint.zip" \
            "https://github.com/terraform-linters/tflint/releases/download/v${TFLINT_VERSION}/tflint_linux_amd64.zip"
          echo "$TFLINT_SHA256  $RUNNER_TEMP/tflint.zip" | sha256sum --check --strict
          curl --fail --silent --show-error --location --output "$RUNNER_TEMP/ruleset.zip" \
            "https://github.com/terraform-linters/tflint-ruleset-aws/releases/download/v${RULESET_VERSION}/tflint-ruleset-aws_linux_amd64.zip"
          echo "$RULESET_SHA256  $RUNNER_TEMP/ruleset.zip" | sha256sum --check --strict
          unzip -q -o "$RUNNER_TEMP/tflint.zip" tflint -d "$tools"
          unzip -q -o "$RUNNER_TEMP/ruleset.zip" tflint-ruleset-aws -d "$plugins"
          echo "$tools" >> "$GITHUB_PATH"

{% endif %}
      - name: Check the generated code
        uses: {{ toolchain_action }}
        with:
          version: {{ toolchain_version | yaml_string }}
          command: check-output
{% for app in applications %}

  # Install the dependencies of {{ app.name }} from the committed lockfile, then
  # run the linter, the type checker and the tests (PRD-CICD-004).
  {{ app.job }}:
    name: {{ ("Test " ~ app.name) | yaml_string }}
    runs-on: {{ runner }}
    timeout-minutes: 30
    permissions:
      contents: read
    defaults:
      run:
        working-directory: {{ app.folder | yaml_string }}
    steps:
{{ setup() }}
      # A lockfile that does not agree with pyproject.toml makes the job fail.
      - name: Check the lockfile
        run: uv lock --check

      - name: Install the dependencies from the lockfile
        run: uv sync --frozen

      - name: Lint
        run: uv run --frozen ruff check --output-format=github

      - name: Check the format
        run: uv run --frozen ruff format --check

      - name: Check the types
        run: uv run --frozen pyright

      - name: Test
        run: uv run --frozen pytest
{% endfor %}
{% for app in pnpm_applications %}

  # Install the dependencies of {{ app.name }} from the committed lockfile, then
  # run the type checker, the linters, the format check and the tests
  # (PRD-CICD-004, decision record 09, Q64).
  {{ app.job }}:
    name: {{ ("Test " ~ app.name) | yaml_string }}
    runs-on: {{ runner }}
    timeout-minutes: 30
    permissions:
      contents: read
    defaults:
      run:
        working-directory: {{ app.folder | yaml_string }}
    steps:
{{ setup(with_uv=False) }}
{{ setup_pnpm(app) }}
      # A lockfile that does not agree with package.json makes the step fail.
      - name: Install the dependencies from the lockfile
        run: pnpm install --frozen-lockfile

      - name: Check the types
        run: pnpm exec tsc --noEmit

      - name: Lint
        run: pnpm exec eslint .

      - name: Check the layers
        run: pnpm exec steiger ./src

      - name: Check the format
        run: pnpm exec prettier --check .

      - name: Test
        run: pnpm exec vitest run
{% endfor %}
{% if plan %}

  # Plan the infrastructure of {{ plan.environment }} with the read-only plan role
  # (PRD-CICD-006, PRD-CICD-010). The job does not apply. The plan role
  # cannot write the state lock, thus the plan does not lock the state.
  # OpenTofu does not show sensitive values in the plan text
  # (PRD-CICD-015).
  {{ plan.job }}:
    name: {{ ("Plan " ~ plan.environment) | yaml_string }}
    runs-on: {{ runner }}
    timeout-minutes: 30
    permissions:
      contents: read
      id-token: write
    defaults:
      run:
        working-directory: {{ plan.folder | yaml_string }}
    steps:
{{ setup(with_uv=False) }}
      - name: Set up OpenTofu
        uses: {{ actions.setup_opentofu }}
        with:
          tofu_version: {{ opentofu_version | yaml_string }}
          tofu_wrapper: false

      - name: Get AWS credentials for the plan role
        uses: {{ actions.configure_aws_credentials }}
        with:
          role-to-assume: {{ plan.role_arn | yaml_string }}
          aws-region: {{ plan.region | yaml_string }}

      - name: Initialize OpenTofu
        run: tofu init -input=false

      - name: Plan {{ plan.environment }}
        env:
          MODEL_COMMIT: {{ "${{ github.event.pull_request.head.sha }}" }}
        run: tofu plan -input=false -lock=false -no-color -var "model_commit=$MODEL_COMMIT" -out=plan.tfplan

      - name: Write the plan in the job summary
        run: |
          {
            echo "## Plan of {{ plan.environment }}"
            echo
            echo '```text'
            tofu show -no-color plan.tfplan
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"
{% endif %}
