{#- One trace report as one HTML file (PRD-TRACE-017, PRD-TRACE-018).
    Data: "report" (a dsml.trace.report.Report), "baseline" (the baseline
    commit, or "none") and "rows" (the cells of each row). A cell has "texts", "list" (true for a
    list cell) and "style" (a CSS class for a status, or an empty text).
    The page has its styles in the file. It has no script and no reference to
    an external resource. The template escapes each text of the report. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DSML trace report: {{ report.name | e }}</title>
<style>
:root { color-scheme: light dark; }
body { margin: 1rem; font-family: system-ui, sans-serif; font-size: 0.9rem; }
h1 { font-size: 1.3rem; }
dl { display: grid; grid-template-columns: max-content auto; gap: 0.2rem 1rem; }
dt { font-weight: bold; }
dd { margin: 0; font-family: monospace; }
.table { overflow-x: auto; }
table { border-collapse: collapse; }
th, td { border: 1px solid #8888; padding: 0.3rem 0.5rem; text-align: left; vertical-align: top; }
th { background: #8882; }
td { font-family: monospace; }
ul { margin: 0; padding-left: 1rem; }
.status-missing { color: #c62828; font-weight: bold; }
.status-satisfied { color: #b26a00; }
.status-verified { color: #2e7d32; }
</style>
</head>
<body>
<h1>DSML trace report: {{ report.name | e }}</h1>
<dl>
<dt>Model commit</dt>
<dd>{{ report.model_commit | e }}</dd>
<dt>Baseline commit</dt>
<dd>{{ baseline | e }}</dd>
<dt>Rows</dt>
<dd>{{ rows | length }}</dd>
</dl>
<div class="table">
<table>
<thead>
<tr>
{% for column in report.columns %}
<th scope="col">{{ column | e }}</th>
{% endfor %}
</tr>
</thead>
<tbody>
{% for row in rows %}
<tr>
{% for cell in row %}
{% if cell.list %}
<td>{% if cell.texts %}<ul>{% for text in cell.texts %}<li>{{ text | e }}</li>{% endfor %}</ul>{% endif %}</td>
{% elif cell.style %}
<td class="{{ cell.style }}">{{ cell.texts[0] | e }}</td>
{% else %}
<td>{{ cell.texts[0] | e }}</td>
{% endif %}
{% endfor %}
</tr>
{% endfor %}
</tbody>
</table>
</div>
</body>
</html>
