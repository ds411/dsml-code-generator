{#- The model segment of an entity slice: the TypeScript types and the Zod
    schemas (PRD-APP-210, PRD-APP-211). Data: "entity" (a
    dsml.generate.react_entities.EntitySlice). The schemas follow the
    Pydantic models of the called application (PRD-APP-005, PRD-APP-112,
    PRD-APP-115). -#}
{% include "common/header.j2" %}
import { z } from "zod";
{% if entity.uses_decimal %}

{% include "react/entities/decimal.ts.j2" %}
{% endif %}
{% if entity.has_output %}

/** The entity {{ entity.name }} in a response. A related entity is its key. */
export const {{ entity.camel }}Schema = {% for line in entity.output_lines() %}{{ line }}
{% endfor %}

/** The entity {{ entity.name }} in a response. */
{% for line in entity.type_lines(entity.pascal, "infer", entity.camel ~ "Schema") %}
{{ line }}
{% endfor %}
{% endif %}
{% if "list" in entity.queries %}

/** One page of the entities {{ entity.name }}, sorted by key, and the number of all entities. */
export const {{ entity.camel }}PageSchema = z.object({
  items: z.array({{ entity.camel }}Schema),
  total: z.int(),
});

/** One page of the entities {{ entity.name }}. */
{% for line in entity.type_lines(entity.pascal ~ "Page", "infer", entity.camel ~ "PageSchema") %}
{{ line }}
{% endfor %}
{% endif %}
{% for operation in entity.inputs %}

/** {{ entity.input_doc(operation) }} */
export const {{ operation }}{{ entity.pascal }}InputSchema = {% for line in entity.input_lines(operation) %}{{ line }}
{% endfor %}

/** {{ entity.input_doc(operation) }} */
{% for line in entity.type_lines((operation | pascal_case) ~ entity.pascal ~ "Input", "input", operation ~ entity.pascal ~ "InputSchema") %}
{{ line }}
{% endfor %}
{% endfor %}
