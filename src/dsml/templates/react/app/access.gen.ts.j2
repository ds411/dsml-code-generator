{#- The access rules of the routes (PRD-APP-009, PRD-APP-222). The function
    "requireView" gives the "beforeLoad" function of the route of a view.
    It checks the session and the roles of the view. Data: none. -#}
{% include "common/header.j2" %}
import { type Session, startLogin } from "{{ layout.import_path("shared", "auth") }}";

/** The access rule of a view (PRD-DSML-033). */
export interface ViewAccess {
  /** Tell if the view needs no session: the attribute "public" of the view. */
  readonly public: boolean;
  /** The roles that can use the view: the user pool groups of the users. */
  readonly roles: readonly string[];
}

/** The error of a route that the roles of the user do not permit. */
export class NotPermittedError extends Error {
  constructor() {
    super("Your roles do not permit this page.");
    this.name = "NotPermittedError";
  }
}

/** The error of a route that needs a session. The login started. */
export class LoginStartedError extends Error {
  constructor() {
    super("The page needs a login. The login started.");
    this.name = "LoginStartedError";
  }
}

/**
 * Tell if the session permits a view. A public view needs no session.
 * Each other view needs a session with one of the roles of the view.
 */
export function isPermitted(
  session: Session | undefined,
  access: ViewAccess,
): boolean {
  if (access.public) {
    return true;
  }
  return (
    session !== undefined &&
    session.groups.some((group) => access.roles.includes(group))
  );
}

/**
 * Check the session and the roles of a view before the route loads data
 * (PRD-APP-222). With no session, start the login and give a
 * LoginStartedError. With no permitted role, give a NotPermittedError.
 */
export async function checkAccess(
  session: Session | undefined,
  access: ViewAccess,
): Promise<void> {
  if (access.public) {
    return;
  }
  if (session === undefined) {
    await startLogin();
    throw new LoginStartedError();
  }
  if (!isPermitted(session, access)) {
    throw new NotPermittedError();
  }
}

/** Give the "beforeLoad" function of the route of a view. */
export function requireView(access: ViewAccess) {
  return ({
    context,
  }: {
    context: { session: Session | undefined };
  }): Promise<void> => checkAccess(context.session, access);
}
