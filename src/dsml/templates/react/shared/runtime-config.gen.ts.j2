{#- The segment shared/config: the runtime configuration of the application
    (PRD-APP-010, PRD-APP-230, Q43). The deployment pipeline writes
    /config.json for each environment (PRD-CICD-019). Data: "path" (the path
    of the file) and "keys" (the keys of the file, in the order of the
    pipeline). -#}
{% include "common/header.j2" %}
import { z } from "zod";

/** The path of the runtime configuration file on the site. */
export const RUNTIME_CONFIG_PATH = "{{ path }}";

/**
 * The runtime configuration. The deployment pipeline writes it for each
 * environment. Thus one build operates in all environments.
 */
export const runtimeConfigSchema = z.object({
  /** The URL of the API that the application calls. */
  {{ keys[0] }}: z.url(),
  /** The AWS Region of the environment. */
  {{ keys[1] }}: z.string().min(1),
  /** The ID of the Cognito user pool. */
  {{ keys[2] }}: z.string().min(1),
  /** The ID of the app client of the application in the user pool. */
  {{ keys[3] }}: z.string().min(1),
  /** The managed login domain of the user pool, with no scheme. */
  {{ keys[4] }}: z.string().min(1),
});

export type RuntimeConfig = z.infer<typeof runtimeConfigSchema>;

let loaded: RuntimeConfig | undefined;

/**
 * Read the runtime configuration from the site. The application must call
 * this function before the first render.
 */
export async function loadRuntimeConfig(): Promise<RuntimeConfig> {
  const response = await fetch(RUNTIME_CONFIG_PATH, { cache: "no-store" });
  if (!response.ok) {
    throw new Error(
      `The application cannot read ${RUNTIME_CONFIG_PATH}. The status is ${String(response.status)}.`,
    );
  }
  const body: unknown = await response.json();
  loaded = runtimeConfigSchema.parse(body);
  return loaded;
}

/** Give the runtime configuration that loadRuntimeConfig read. */
export function runtimeConfig(): RuntimeConfig {
  if (loaded === undefined) {
    throw new Error(
      "The runtime configuration is not loaded. Call loadRuntimeConfig before the first render.",
    );
  }
  return loaded;
}
