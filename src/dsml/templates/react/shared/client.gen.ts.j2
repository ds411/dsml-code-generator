{#- The segment shared/api: the API client (PRD-APP-014, PRD-APP-227,
    PRD-APP-232). The entity and feature slices call apiRequest through the
    public API @/shared/api. Data: "problem_media_type". -#}
{% include "common/header.j2" %}
import { z } from "zod";

import { accessToken } from "{{ layout.import_path("shared", "auth") }}";
import { runtimeConfig } from "{{ layout.import_path("shared", "config") }}";

/** One request to the API that the application calls. */
export interface ApiRequest {
  method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE";
  /** The path of the operation, after the API base URL. */
  path: string;
  /** The query parameters. */
  query?: Readonly<Record<string, string | number | boolean>>;
  /** The request body. The client sends it as JSON. */
  body?: unknown;
  signal?: AbortSignal;
}

/** The media type of a problem details response (RFC 9457). */
export const PROBLEM_MEDIA_TYPE = "{{ problem_media_type }}";

/** The members of a problem details response that the client uses. */
export const problemSchema = z.object({
  title: z.string().optional(),
  detail: z.string().optional(),
});

/**
 * An error response of the API. The message has the title and the detail
 * of the problem details response.
 */
export class ApiError extends Error {
  readonly status: number;
  readonly title: string;
  readonly detail: string | undefined;

  constructor(status: number, title: string, detail?: string) {
    super(detail === undefined ? title : `${title}: ${detail}`);
    this.name = "ApiError";
    this.status = status;
    this.title = title;
    this.detail = detail;
  }
}

/** Give the URL of a request: the API base URL, the path and the query. */
export function apiUrl(path: string, query: ApiRequest["query"] = {}): string {
  const base = runtimeConfig().apiBaseUrl.replace(/\/+$/, "");
  const url = new URL(`${base}${path}`);
  for (const [name, value] of Object.entries(query)) {
    url.searchParams.set(name, String(value));
  }
  return url.toString();
}

/**
 * Send a request to the API and give the JSON body of the response. A
 * response with no body gives `undefined`. The client adds the access token
 * of the session as a bearer token. An error response gives an ApiError.
 */
export async function apiRequest(request: ApiRequest): Promise<unknown> {
  const headers = new Headers({
    Accept: `application/json, ${PROBLEM_MEDIA_TYPE}`,
  });
  const token = await accessToken();
  if (token !== undefined) {
    headers.set("Authorization", `Bearer ${token}`);
  }
  let body: string | null = null;
  if (request.body !== undefined) {
    headers.set("Content-Type", "application/json");
    body = JSON.stringify(request.body);
  }
  const response = await fetch(apiUrl(request.path, request.query), {
    method: request.method,
    headers,
    body,
    signal: request.signal ?? null,
  });
  if (!response.ok) {
    throw await apiError(response);
  }
  const text = await response.text();
  return text === "" ? undefined : (JSON.parse(text) as unknown);
}

/** Give the ApiError of an error response. */
async function apiError(response: Response): Promise<ApiError> {
  const fallback =
    response.statusText || `The status is ${String(response.status)}.`;
  const mediaType = response.headers.get("Content-Type") ?? "";
  if (mediaType.split(";")[0]?.trim().toLowerCase() !== PROBLEM_MEDIA_TYPE) {
    return new ApiError(response.status, fallback);
  }
  const body: unknown = await response.json().catch(() => undefined);
  const problem = problemSchema.safeParse(body);
  if (!problem.success) {
    return new ApiError(response.status, fallback);
  }
  return new ApiError(
    response.status,
    problem.data.title ?? fallback,
    problem.data.detail,
  );
}
