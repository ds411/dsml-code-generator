{#- The ui segment of the widget slice of a detail view: the fields of one
    entity (PRD-APP-210). The widget reads the data with the query options
    of the entity slice. Data: "widget" (a
    dsml.generate.react_widgets.WidgetSlice). -#}
{% include "common/header.j2" %}
{% if layout.rsc %}
"use client";

{% endif %}
{% for line in widget.import_lines(layout) %}
{{ line }}
{% endfor %}

/** The properties of the details of the entity {{ widget.entity.name }}. */
export interface {{ widget.component }}Props {
  /** The key of the entity that the details show. */
  {{ widget.key }}: {{ widget.key_type }};
}

/** Show an error of the query. A problem details response gives the title and the detail. */
function QueryError({ error }: { error: Error }): ReactNode {
  const title = error instanceof ApiError ? error.title : error.message;
  const detail = error instanceof ApiError ? error.detail : undefined;
  return (
    <Alert variant="destructive">
      <AlertTitle>{title}</AlertTitle>
      {detail === undefined ? null : (
        <AlertDescription>{detail}</AlertDescription>
      )}
    </Alert>
  );
}
{% if widget.uses_yes_no %}

/** Give the text of a Boolean value. A null value gives an empty text. */
function yesNo(value: boolean | null): string {
  if (value === null) {
    return "";
  }
  return value ? "Yes" : "No";
}
{% endif %}

/** The details of one entity {{ widget.entity.name }}: {{ widget.route }}. */
